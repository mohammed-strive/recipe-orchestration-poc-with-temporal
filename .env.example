# Copy to .env. docker compose and podman-compose read it, and so do the engine processes when run on the host.

# claude: AI steps run in Claude Agent SDK sessions (needs ANTHROPIC_API_KEY).
# stub:   AI steps produce placeholder output (no model, no cost) to test the plumbing.
AGENT_RUNNER=claude
ANTHROPIC_API_KEY=
# claude: rerank discovery candidates with the Messages API. none: retrieval scores only.
RERANK=claude
DEFAULT_MODEL=claude-sonnet-5-5

# Worker pool settings. AI_RATE_PER_SEC is enforced by Temporal across every AI worker.
AI_CONCURRENCY=4
AI_RATE_PER_SEC=2
MAX_ACTIVE_RUNS_PER_USER=10

# Development identities: token:user:role|role,...  (production: single sign-on tokens)
# ENGINE_TOKENS=dev-analyst-token:analyst@example.com:analyst,dev-lead-token:lead@example.com:analyst|finance-lead|ops-lead,...
