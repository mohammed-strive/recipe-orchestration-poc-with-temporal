{
  "name": "recipe-engine-temporal",
  "version": "0.1.0",
  "private": true,
  "description": "Recipe engine on Temporal: stateless MCP API, durable recipe workflows, and worker pools for code, tool, AI and discovery steps",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "api": "node --env-file-if-exists=../.env dist/api/index.js",
    "worker": "node --env-file-if-exists=../.env dist/worker.js",
    "dev:all": "node --env-file-if-exists=../.env dist/worker.js --role all"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "@anthropic-ai/sdk": "1.12.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@temporalio/activity": "1.26.0",
    "@temporalio/client": "1.26.0",
    "@temporalio/worker": "1.26.0",
    "@temporalio/workflow": "1.26.0",
    "ajv": "^8.17.1",
    "express": "^4.21.2",
    "jsonata": "^2.0.6",
    "pg": "^8.13.1",
    "yaml": "^2.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
